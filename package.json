{
  "name": "vscode-git-client",
  "displayName": "mygit",
  "description": "A GitKraken-style Git client for the workspace repository: commit graph, branches, staging, diffs, merge tool and interactive rebase.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["SCM Providers"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:mygit.client"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "mygit", "title": "mygit", "icon": "media/mygit.svg" }
      ]
    },
    "views": {
      "mygit": [
        { "id": "mygit.launcher", "name": "Repository", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "mygit.show", "title": "Show", "category": "mygit" },
      { "command": "mygit.fetchAll", "title": "Fetch All", "category": "mygit" },
      { "command": "mygit.pull", "title": "Pull", "category": "mygit" },
      { "command": "mygit.push", "title": "Push", "category": "mygit" },
      { "command": "mygit.createBranch", "title": "Create Branch", "category": "mygit" },
      { "command": "mygit.renameBranch", "title": "Rename Branch", "category": "mygit" },
      { "command": "mygit.stash", "title": "Stash Changes", "category": "mygit" },
      { "command": "mygit.popStash", "title": "Pop Stash", "category": "mygit" },
      { "command": "mygit.stageAll", "title": "Stage All Changes", "category": "mygit" },
      { "command": "mygit.unstageAll", "title": "Unstage All Changes", "category": "mygit" },
      { "command": "mygit.undo", "title": "Undo", "category": "mygit" },
      { "command": "mygit.redo", "title": "Redo", "category": "mygit" },
      { "command": "mygit.createFile", "title": "Create File", "category": "mygit" },
      { "command": "mygit.editFile", "title": "Edit File", "category": "mygit" },
      { "command": "mygit.fileHistory", "title": "File History and Blame", "category": "mygit" },
      { "command": "mygit.createPatch", "title": "Create Patch", "category": "mygit" },
      { "command": "mygit.applyPatch", "title": "Apply Patch", "category": "mygit" },
      { "command": "mygit.editCommitTemplate", "title": "Edit Commit Template", "category": "mygit" },
      { "command": "mygit.sparseCheckout", "title": "Sparse Checkout Settings", "category": "mygit" },
      { "command": "mygit.setHooksPath", "title": "Set Git Hooks Path", "category": "mygit" },
      { "command": "mygit.openRepoFolder", "title": "Open Repository in File Manager", "category": "mygit" },
      { "command": "mygit.showActivityLog", "title": "Show Activity Log", "category": "mygit" },
      { "command": "mygit.checkConflicts", "title": "Check for Conflicts with Target Branches", "category": "mygit" },
      { "command": "mygit.openSettings", "title": "Open Preferences", "category": "mygit" },
      { "command": "mygit.commandPalette", "title": "Command Palette", "category": "mygit" },
      { "command": "mygit.key.find", "title": "Search Commits", "category": "mygit" },
      { "command": "mygit.key.focusMessage", "title": "Focus Commit Message", "category": "mygit" },
      { "command": "mygit.key.focusFilter", "title": "Focus Left Panel Filter", "category": "mygit" },
      { "command": "mygit.key.toggleLeft", "title": "Toggle Left Panel", "category": "mygit" },
      { "command": "mygit.key.toggleDetail", "title": "Toggle Commit Panel", "category": "mygit" },
      { "command": "mygit.key.shortcuts", "title": "Keyboard Shortcuts", "category": "mygit" },
      { "command": "mygit.key.externalDiff", "title": "Open Diff or Merge Tool", "category": "mygit" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "mygit.commandPalette", "when": "false" },
        { "command": "mygit.key.find", "when": "false" },
        { "command": "mygit.key.focusMessage", "when": "false" },
        { "command": "mygit.key.focusFilter", "when": "false" },
        { "command": "mygit.key.toggleLeft", "when": "false" },
        { "command": "mygit.key.toggleDetail", "when": "false" },
        { "command": "mygit.key.shortcuts", "when": "false" },
        { "command": "mygit.key.externalDiff", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "mygit.createBranch", "key": "ctrl+b", "mac": "cmd+b", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.fetchAll", "key": "ctrl+l", "mac": "cmd+l", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.stageAll", "key": "ctrl+shift+s", "mac": "cmd+shift+s", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.unstageAll", "key": "ctrl+shift+u", "mac": "cmd+shift+u", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.key.focusMessage", "key": "ctrl+shift+m", "mac": "cmd+shift+m", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.commandPalette", "key": "ctrl+p", "mac": "cmd+p", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.key.find", "key": "ctrl+f", "mac": "cmd+f", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.fileHistory", "key": "ctrl+shift+h", "mac": "cmd+shift+h", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.key.focusFilter", "key": "ctrl+alt+f", "mac": "cmd+alt+f", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.openRepoFolder", "key": "alt+o", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.key.externalDiff", "key": "ctrl+d", "mac": "cmd+d", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.key.toggleLeft", "key": "ctrl+j", "mac": "cmd+j", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.key.toggleDetail", "key": "ctrl+k", "mac": "cmd+k", "when": "activeWebviewPanelId == 'mygit.client'" },
      { "command": "mygit.key.shortcuts", "key": "ctrl+/", "mac": "cmd+/", "when": "activeWebviewPanelId == 'mygit.client'" }
    ],
    "configuration": {
      "title": "mygit",
      "properties": {
        "mygit.autoFetchInterval": { "type": "number", "default": 1, "minimum": 0, "maximum": 60, "description": "Minutes between automatic fetches of all remotes. 0 disables auto-fetch." },
        "mygit.autoPrune": { "type": "boolean", "default": true, "description": "Prune remote-tracking refs that no longer exist on the remote when fetching." },
        "mygit.conflictDetection": { "type": "boolean", "default": true, "description": "Automatic Conflict Detection: predict conflicts between the checked-out branch and its target branches." },
        "mygit.conflictPrevention.targetBranches": { "type": "array", "items": { "type": "string" }, "default": ["main", "master", "develop", "origin/main", "origin/master", "origin/develop"], "scope": "resource", "description": "Branches monitored for conflicts. `**` matches across `/`, a leading `!` excludes." },
        "mygit.deleteOrigFiles": { "type": "boolean", "default": true, "description": "Delete .orig backup files after resolving conflicts." },
        "mygit.initialCommits": { "type": "number", "default": 2000, "minimum": 500, "description": "Commits loaded into the graph initially (and per further page)." },
        "mygit.showAllCommits": { "type": "boolean", "default": false, "description": "Load the full history into the graph." },
        "mygit.lazyLoadCommits": { "type": "boolean", "default": true, "description": "Load further commits when the graph is scrolled to the bottom." },
        "mygit.extendedLogging": { "type": "boolean", "default": false, "description": "Use extended logging in the Activity Log (each git command, auto-fetch, conflict detection)." },
        "mygit.diffTool": { "type": "string", "enum": ["vscode", "gitConfig"], "enumDescriptions": ["VS Code diff editor", "Git Config Default (diff.tool)"], "default": "vscode", "description": "External diff tool opened with Ctrl+D." },
        "mygit.mergeTool": { "type": "string", "enum": ["vscode", "gitConfig"], "enumDescriptions": ["VS Code merge editor", "Git Config Default (merge.tool)"], "default": "vscode", "description": "External merge tool for conflicted files." },
        "mygit.dateFormat": { "type": "string", "enum": ["relative", "locale", "iso"], "default": "relative", "description": "Date/Time format in the graph and commit details." },
        "mygit.dateLocale": { "type": "string", "default": "", "description": "Date/Time locale (BCP 47 tag, for example en-GB). Empty uses the system locale." },
        "mygit.authorDisplay": { "type": "string", "enum": ["initials", "avatars"], "enumDescriptions": ["Coloured initials", "Gravatar images (sends hashed e-mail addresses to gravatar.com)"], "default": "initials", "description": "Author display on graph nodes and commit details." },
        "mygit.graphMetadata": { "type": "array", "items": { "type": "string", "enum": ["branches", "tags"] }, "default": ["branches", "tags"], "description": "Reference labels shown in the Branch / Tag column." },
        "mygit.highlightOnBranchHover": { "type": "boolean", "default": true, "description": "Highlight the commits of a branch when hovering its label." },
        "mygit.showToolbarLabels": { "type": "boolean", "default": true, "description": "Show text labels under toolbar icons." },
        "mygit.applyCommitTemplate": { "type": "boolean", "default": true, "description": "Apply the commit template (commit.template) to the commit message fields." },
        "mygit.removeTemplateComments": { "type": "boolean", "default": true, "description": "Remove lines starting with # when applying the commit template." },
        "mygit.squashMerge": { "type": "boolean", "default": false, "description": "Merge Behavior: Squash. Merging stages all changes without creating a merge commit; commit manually." },
        "mygit.gpgSign": { "type": "boolean", "default": false, "description": "Sign commits with GPG (git commit -S, user.signingkey)." }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "preact": "^10.19.0",
    "@testing-library/preact": "^3.2.3",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
