#!/usr/bin/env bash
# Package, tag and publish a GitHub release of the extension.
# Usage: bin/release [patch|minor|major]   (default: patch)
set -euo pipefail

bump="${1:-patch}"
case "$bump" in
  patch|minor|major) ;;
  *) echo "usage: $0 [patch|minor|major]" >&2; exit 64 ;;
esac

cd "$(dirname "$0")/.."

if [[ -n "$(git status --porcelain)" ]]; then
  echo "error: working tree is not clean" >&2
  exit 1
fi

npm test

# Bumps package.json, commits "X.Y.Z", tags vX.Y.Z and builds the .vsix.
npx @vscode/vsce package "$bump"

name="$(node -p "require('./package.json').name")"
version="$(node -p "require('./package.json').version")"
tag="v$version"
vsix="$name-$version.vsix"

git push --atomic origin HEAD "$tag"
gh release create "$tag" "$vsix" --title "$tag" --generate-notes
